<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duolingo Chess Copilot"
        android:textColor="#00E676"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="多邻国国际象棋全透明穿透悬浮助手"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- 悬浮球总开关 -->
    <Button
        android:id="@+id/btnToggleFloating"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#00E676"
        android:text="启动屏幕悬浮球 (Start Copilot)"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 诊断自测分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:background="#333333" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="【离线单步诊断面板】(无需悬浮直接测试)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2C2C2C"
        android:text="从相册选取多邻国截图测试"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvDiagnosticResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:text="请选择截图进行 100% 精度诊断..."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:typeface="monospace" />

</LinearLayout>
