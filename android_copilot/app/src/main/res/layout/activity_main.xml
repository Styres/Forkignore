<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duolingo Chess Copilot"
        android:textColor="#00E676"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Vollständig transparenter Overlay-Assistent für Duolingo-Schach"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <!-- Umschalter für die Blase: an = Dienst läuft, aus = Dienst beendet -->
    <ToggleButton
        android:id="@+id/btnToggleFloating"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#00E676"
        android:textOff="Overlay-Assistent starten"
        android:textOn="Overlay-Assistent stoppen"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBubbleHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tipp: kurz auf die Blase tippen analysiert die Stellung, langes Drücken schaltet die eigene Farbe um, falls die Zuordnung einmal vertauscht ist."
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <!-- Trennlinie zur Einzelbild-Diagnose -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:background="#333333" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[Diagnose einzelner Screenshots] (ohne Overlay testen)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2C2C2C"
        android:text="Duolingo-Screenshot aus der Galerie prüfen"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvDiagnosticResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:text="Bitte einen Screenshot zur Prüfung auswählen ..."
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:typeface="monospace" />

</LinearLayout>
