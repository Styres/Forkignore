<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollbar, weil die Foto-Schaltfläche zusammen mit der Diagnoseausgabe höher wird als kleine Displays -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DuLo"
            android:textColor="#00E676"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Vollständig transparenter Overlay-Assistent für Duolingo-Schach"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <!--
          Umschalter für die Blase: an = Dienst läuft, aus = Dienst beendet.
          Die Schaltfläche ist das Foto von DuLo; ausgeschaltet liegt ein dunkler
          Schleier darüber, eingeschaltet leuchtet das Bild mit grünem Rahmen.
        -->
        <ToggleButton
            android:id="@+id/btnToggleFloating"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/dulo_umschalter_hintergrund"
            android:contentDescription="Overlay-Assistent ein- und ausschalten"
            android:textOff=""
            android:textOn=""
            android:text=""
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <TextView
            android:id="@+id/tvToggleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Assistent aus – auf DuLo tippen zum Starten"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBubbleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tipp: kurz auf die Blase tippen analysiert die Stellung, langes Drücken schaltet die eigene Farbe um, falls die Zuordnung einmal vertauscht ist."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <!-- Trennlinie zur Einzelbild-Diagnose -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Diagnose einzelner Screenshots] (ohne Overlay testen)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2C2C2C"
            android:text="Duolingo-Screenshot aus der Galerie prüfen"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvDiagnosticResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:text="Bitte einen Screenshot zur Prüfung auswählen ..."
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:typeface="monospace" />

    </LinearLayout>

</ScrollView>
